# Rename this file to .env and fill in your values

# Flask
SECRET_KEY=change-this-to-a-random-secret-key

# Database - choose ONE
# Option A (default, zero-setup): SQLite - just leave DB_TYPE=sqlite
# Option B: MySQL / XAMPP - set DB_TYPE=mysql and fill the details below
DB_TYPE=sqlite
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_mock_interviewer

# Optional: plug in a real AI provider for smarter answer scoring.
# Leave AI_PROVIDER blank to use the built-in offline heuristic AI engine
# (works instantly, no key, no cost, no internet needed).
# Supported values: openai | anthropic
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
